# Figma credentials for scripts/generate-icons.ts
# Figma personal access token: https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=
# File key — the segment after /file/ or /design/ in the Figma URL
FIGMA_FILE_KEY=
# Pages (canvases) holding the icon frames, as weight=page pairs.
# Default: normal=normal,bold=bold. (The old single-value FIGMA_PAGE is ignored
# with a warning.)
FIGMA_PAGES=
