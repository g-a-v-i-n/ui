{
  "extends": "./tsconfig.json",
  "include": ["scripts", "tools", "oxlint.config.ts"],
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "lib": ["ES2023"],
    "skipLibCheck": true
  }
}
